                        @if (summary.TotalToBePurchasedBins == 0)
                        {
                            <p class="text-muted mb-0">Everything is available in stock. No purchases needed.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm mb-0">
                                    <thead>
                                        <tr>
                                            <th>Material</th>
                                            <th>Length</th>
                                            <th class="text-end">Qty</th>
